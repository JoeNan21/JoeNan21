# Joey Digital Twin - environment template
# Copy to .env. NEVER commit .env. No credentials belong in this repository.
#
# v0.1 runs fully offline with the deterministic provider. None of the keys
# below are required for `twin decide` or `twin eval` to work.

# --- LLM providers (optional, adapters are NOT implemented in v0.1) ---------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# --- Persistence (NOT provisioned in v0.1; local JSON is used instead) ------
# Postgres-compatible connection string for a future Supabase/Postgres backend.
# DATABASE_URL=postgresql://user:password@host:5432/joey_twin
DATABASE_URL=

# --- Engine configuration ---------------------------------------------------
TWIN_MEMORY_ROOT=./memory
TWIN_DEFAULT_MODE=general
TWIN_DEFAULT_PROVIDER=deterministic
